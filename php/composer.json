        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "ascii85encoder",
        "ascii85",
        "base85",
        "encoding",
        "decoding",
        "data encoding"
    ],
    "homepage": "https://apiverve.com/marketplace/ascii85encoder?utm_source=php&utm_medium=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/ascii85encoder",
        "source": "https://github.com/apiverve/ascii85encoder-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
